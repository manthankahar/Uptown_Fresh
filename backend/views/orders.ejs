<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>My Orders</title>

<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="data:,">

</head>

<body>

<%- include("partials/navbar") %>

<h1 class="page-title">
📦 My Orders
</h1>

<div
id="orders"
class="products-container"
>

Loading...

</div>

<script src="/toast.js"></script>

<script>

// const token = localStorage.getItem("token");

async function loadOrders(){

try{

const response = await fetch(
"http://localhost:5000/api/orders/my",
{
headers:{
Authorization:`Bearer ${localStorage.getItem("token")}`
}
}
);

const orders = await response.json();

let html = "";

if(!orders.length){

html = `

<div
style="
width:100%;
text-align:center;
padding:60px;
"
>

<h2>
📦 No Orders Yet
</h2>

<p>
Start Shopping Fresh Products
</p>

<br>

<a
href="/products"
class="btn"
>

🛒 Shop Now

</a>

</div>

`;

}else{

orders.forEach(order=>{

let productsHTML = "";

order.products.forEach(item=>{

productsHTML += `

<li>

${item.productId.name}

&nbsp;

<b>x${item.quantity}</b>

</li>

`;

});

html += `

<div class="product-card">

<h2 style="display:flex;justify-content:space-between;align-items:center;">

<span>
📦 Order
</span>

<span
style="
font-size:14px;
background:#27ae60;
color:white;
padding:6px 12px;
border-radius:20px;
"
>

${order.trackingId}

</span>

</h2>


<hr>

<p>

<b>🚚 Status :</b>

<span
class="status-badge status-${order.status.replace(/\s/g,'')}"
>

${order.status}

</span>

</p>

<p>

<b>⏰ ETA :</b>

${order.estimatedDelivery ?

new Date(order.estimatedDelivery)
.toLocaleTimeString([],{
hour:'2-digit',
minute:'2-digit'
})

:

"N/A"

}

</p>

<p>

<b>🆔 Tracking :</b>

${order.trackingId}

</p>

<div class="progress-container">

<div
class="progress-bar"

style="
width:
${
order.status=="Placed"
? "25%"
:
order.status=="Confirmed"
? "50%"
:
order.status=="Out For Delivery"
? "75%"
:
order.status=="Delivered"
? "100%"
:
"0%"
}
"

>

</div>

</div>

<div class="tracking-timeline">

<div class="step ${order.status=="Placed"?"active":""}">

<div class="circle">🛒</div>

<p>Placed</p>

</div>

<div class="line"></div>

<div class="step ${order.status=="Confirmed" || order.status=="Out For Delivery" || order.status=="Delivered" ? "active":""}">

<div class="circle">✅</div>

<p>Confirmed</p>

</div>

<div class="line"></div>

<div class="step ${order.status=="Out For Delivery" || order.status=="Delivered" ? "active":""}">

<div class="circle">🚚</div>

<p>Out For Delivery</p>

</div>

<div class="line"></div>

<div class="step ${order.status=="Delivered" ? "active":""}">

<div class="circle">🏠</div>

<p>Delivered</p>

</div>

</div>

<p>

<b>Total :</b>

₹${order.totalPrice}

</p>

<p>

<b>Items :</b>

${order.products.length}

</p>

<p>

<b>Date :</b>

${new Date(order.createdAt).toLocaleString()}

</p>

<div class="delivery-card">

<h3>📍 Delivery Address</h3>

<p>
<b>👤 Name :</b>
${order.shippingAddress?.name || "-"}
</p>

<p>
<b>📞 Mobile :</b>
${order.shippingAddress?.mobile || "-"}
</p>

<p>
<b>🏠 Address :</b>
${order.shippingAddress?.address || "-"}
</p>

<p>
<b>🏙 City :</b>
${order.shippingAddress?.city || "-"}
</p>

<p>
<b>📮 Pincode :</b>
${order.shippingAddress?.pincode || "-"}
</p>

</div>

<div
class="countdown"
id="countdown-${order._id}"
data-time="${order.estimatedDelivery}"
>

Loading...

</div>

<br>

<h3>

Products

</h3>

<ul>

${productsHTML}

</ul>

<button
class="btn"
onclick="downloadInvoice('${order._id}')"
>

🧾 Download Invoice

</button>

${order.status=="Placed"
||
order.status=="Confirmed" ? `

<br><br>

<button
class="btn"
style="background:#e74c3c;"
onclick="cancelOrder('${order._id}')"
>

❌ Cancel Order

</button>

` : ""}

</div>

`;

});

}

document.getElementById("orders").innerHTML = html;

startCountdown();

}catch(error){

console.log(error);

showToast(
"Unable To Load Orders",
"error"
);

}

}

// loadOrders();

async function downloadInvoice(orderId){

const token = localStorage.getItem("token");

const response = await fetch(

`http://localhost:5000/api/orders/invoice/${orderId}`,

{

headers:{
Authorization:`Bearer ${token}`
}

}

);

if(!response.ok){

showToast("Invoice Download Failed","error");

return;

}

const blob = await response.blob();

const url = window.URL.createObjectURL(blob);

const a = document.createElement("a");

a.href = url;

a.download = "Invoice.pdf";

document.body.appendChild(a);

a.click();

a.remove();

window.URL.revokeObjectURL(url);

}


// ===============================
// Open Cancel Modal
// ===============================

function cancelOrder(id){

selectedOrderId = id;

document
.getElementById("cancelModal")
.style.display = "flex";

}

// ===============================
// Close Modal
// ===============================

function closeModal(){

document
.getElementById("cancelModal")
.style.display = "none";

selectedOrderId = null;

}

// ===============================
// Confirm Cancel
// ===============================

let selectedOrderId = null;

// Open Modal
function cancelOrder(id){

selectedOrderId = id;

document.getElementById("cancelModal").style.display = "flex";

}

// Close Modal
function closeModal(){

document.getElementById("cancelModal").style.display = "none";

selectedOrderId = null;

}

// Confirm Cancel
async function confirmCancel(){

const response = await fetch(

`http://localhost:5000/api/orders/cancel/${selectedOrderId}`,

{

method:"PUT",

headers:{
Authorization:`Bearer ${localStorage.getItem("token")}`
}

}

);

const data = await response.json();

showToast(data.message,"success");

closeModal();

loadOrders();

}

// Hide Modal on Page Load
// window.onload = function(){

// document.getElementById("cancelModal").style.display = "none";

// loadOrders();

// };

window.onload = function(){

document.getElementById("cancelModal").style.display = "none";

loadOrders();

};

// ===============================
// Live Countdown Timer
// ===============================

function startCountdown(){

const timers = document.querySelectorAll(".countdown");

timers.forEach(timer=>{

const target = new Date(timer.dataset.time).getTime();

function update(){

const now = new Date().getTime();

const distance = target - now;

if(distance <= 0){

timer.innerHTML = "🚚 Arriving Soon";

return;

}

const hours = Math.floor(distance / (1000*60*60));

const minutes = Math.floor((distance%(1000*60*60))/(1000*60));

const seconds = Math.floor((distance%(1000*60))/1000);

timer.innerHTML = `
<div style="
margin-top:10px;
padding:10px;
background:#ecfdf5;
border-radius:10px;
font-weight:bold;
color:#27ae60;
">

⏳ Remaining :
${hours}h ${minutes}m ${seconds}s

</div>
`;

}

update();

setInterval(update,1000);

});

}

</script>

<!-- ============================= -->
<!-- Cancel Order Modal -->
<!-- ============================= -->

<div id="cancelModal" class="modal">

<div class="modal-box">

<h2>⚠ Cancel Order</h2>

<p>
Are you sure you want to cancel this order?
</p>

<div class="modal-buttons">

<button
class="btn"
onclick="closeModal()"
>

No

</button>

<button
class="btn btn-danger"
onclick="confirmCancel()"
>


Yes, Cancel

</button>

</div>

</div>

</div>

</body>

</html>